//function overriding -- to reduce time complexity

#include<iostream>
using namespace std;
class animal{
    public:
    virtual void sound(){
        cout<<"animal makes a sound";
    }
    
};
class dog: public animal{
    public:
    void sound ()override{
    cout<<"dog barks"<<"\n";
    }
    
};
class cat:public animal {
    public:
    void sound()override{
        cout<<"cat meow"<<"\n";
    }
};

int main(){
    dog d;
    cat c;
    c.sound();
    d.sound();
    
}


