//factorial
#include <iostream>
using namespace std;

int factorial(int n){
    //base condition
    int count =0;
    if (n==0||n==1){
        return 1;
    }
    
    
    return n*factorial(n-1);
    
}


int main()
{
    cout<<factorial(4);
    
    return 0;
}



