//factorial
#include <iostream>
using namespace std;

int fibonacci(int n){
    //base condition
    
    if (n==0){
        return 0;
    }
    if(n==1){
        return 1;
    }
    
    
    
   return fibonacci(n-1)+fibonacci(n-2);
   
    
}


int main()
{
    int terms = 10;
   cout << "Fibonacci Series: ";
    for (int i = 0; i < terms; i++) {
        cout << fibonacci(i) << " ";
    }
    
    return 0;
}
