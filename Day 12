//recursion prob 1

#include <iostream>
using namespace std;

void printnumber (int n){
    //base
    if (n>10){
        return ;
    }
    //logic
    cout <<n<<" ";
    printnumber(n+1);
}

int main()
{
    printnumber(1);
    
    return 0;
}


