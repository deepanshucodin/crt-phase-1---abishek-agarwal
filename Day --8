#include<iostream>
using namespace std;
class vehicle{
    public:
    void start(){
        cout<<"vehicle starts"<<"\n";
    }
};

class bike : public vehicle{
    public:
    void drive1(){
        cout<<"bike is running"<<"\n";
    }
};

class car : public vehicle{
    public:
    void drive(){
        cout<<" car is running"<<"\n";
    }
};


int main(){
    car obj1;
 
    obj1.drive();
    obj1.start();
    
    bike obj2;
    obj2.drive1();
    obj2.start();
}


