// problem int16_t
// inheritence
// Types 1.4 multiple inheritence



#include<iostream>
using namespace std;
class parent1{
    public:
    void givememoney(){
    cout<<"mummy paisa do mujhe"<<"\n";
    }
};
class parent2{
    public:
    void givememoney1(){
    cout<<"Papa paisa do mujhe"<<"\n";
    }
};

class child : public parent1, public parent2{
    public:
    void money(){
    cout<<"i got money"<<"\n";
    }
};

int main(){
    child obj1;
    obj1.givememoney1();
    obj1.givememoney();
    obj1.money();
   
}



