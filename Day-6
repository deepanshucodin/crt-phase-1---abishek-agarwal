//problem --1
//swapping of value of 2 variables

#include<iostream>
using namespace std;
void swapnumber(int* x,int* y){
    int temp=*x;
    *x=*y;
    *y=temp;
    
}

int main(){
    int a;
    int b;
    cin>>a;
    cin>>b;
    
    swapnumber(&a, &b);
    cout<<a<<" "<<b;
}






