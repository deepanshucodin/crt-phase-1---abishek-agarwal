//problem 2 
//constructor overloading

#include<iostream>
using namespace std;

class rectangle {
    public:
    int lenght ;
    int width;
    
    rectangle(){
        lenght =1;
        width=1;
        
    }
    rectangle(int side){
        lenght=side;
        width=side;
        
    }
    rectangle(int side1, int side2){
        lenght = side1;
        width = side2;
        
        
    }
    void showarea(){
        cout<<lenght*width<<"\n";
    }
};

int main(){
    rectangle r1;
    rectangle r2(5);
    rectangle r3(5,4);
    
    r1.showarea();
    r2.showarea();
    r3.showarea();
}

